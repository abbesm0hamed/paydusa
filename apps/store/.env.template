NODE_ENV=development

# Your Medusa backend URL
MEDUSA_BACKEND_URL=http://localhost:9100

# Your publishable key for sales channels
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_KEY=

# Medusa admin credentials (for server-side auth)
MEDUSA_ADMIN_EMAIL=admin@medusajs.com
MEDUSA_ADMIN_PASSWORD=

# Your store URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public server URL (used for Payload emails, sitemaps, and metadata)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Default region or default country code
NEXT_PUBLIC_DEFAULT_REGION=tn

# Stripe public key
NEXT_PUBLIC_STRIPE_KEY=

# WWW URL for sitemap/robots
NEXT_PUBLIC_WWW_URL=

# Payload CMS connection
PAYLOAD_SECRET=
DATABASE_URL=postgresql://ecommerce_admin:password@localhost:5555/ecommerce_cms

# Payload CMS server URL
PAYLOAD_SERVER_URL=http://localhost:3000

# Preview secret (for Payload CMS live preview)
PREVIEW_SECRET=

# Next.js revalidation secret (for Payload CMS webhooks)
REVALIDATE_SECRET=

# Facebook domain verification (for meta tags)
FACEBOOK_DOMAIN_VERIFICATION=

# Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare R2 via its S3-compatible API (Node.js)
# Public bucket URL: use a custom domain in production, or an enabled r2.dev URL.
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paydusa
# Upload endpoint: https://<accountId>.r2.cloudflarestorage.com (not the public URL)
R2_ENDPOINT=

# Algolia search
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_PRODUCT_INDEX_NAME=

# The DSN is public; use the storefront project's DSN, not the Medusa DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Optional override (e.g. staging); defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional build-time source map uploads. Keep the auth token server/CI-only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
