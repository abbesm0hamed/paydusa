{
  "name": "store",
  "version": "1.0.5",
  "private": true,
  "description": "complete ecommerce app for tunisians and international businesses",
  "keywords": [
    "ecommerce",
    "shop",
    "store",
    "storefront"
  ],
  "author": "github.com/abbesm0hamed",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "check-types": "tsc --noEmit",
    "test:migration": "node --test tests/payload-v4-migration.test.mjs",
    "test:sentry": "node --test tests/sentry.test.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "analyze": "ANALYZE=true next build",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "bump-deps": "pnpm update --interactive"
  },
  "dependencies": {
    "@ecommerce/design-system": "workspace:*",
    "@ecommerce/medusa": "workspace:*",
    "@headlessui/react": "^2.2.10",
    "@medusajs/icons": "catalog:medusa",
    "@medusajs/js-sdk": "catalog:medusa",
    "@medusajs/ui": "catalog:medusa",
    "@payloadcms/db-postgres": "catalog:payload",
    "@payloadcms/email-resend": "catalog:payload",
    "@payloadcms/live-preview-react": "catalog:payload",
    "@payloadcms/next": "catalog:payload",
    "@payloadcms/plugin-form-builder": "catalog:payload",
    "@payloadcms/plugin-nested-docs": "catalog:payload",
    "@payloadcms/plugin-redirects": "catalog:payload",
    "@payloadcms/plugin-search": "catalog:payload",
    "@payloadcms/plugin-seo": "catalog:payload",
    "@payloadcms/richtext-lexical": "catalog:payload",
    "@payloadcms/storage-s3": "catalog:payload",
    "@payloadcms/transformer-sharp": "catalog:payload",
    "@payloadcms/translations": "catalog:payload",
    "@payloadcms/ui": "catalog:payload",
    "@radix-ui/react-accordion": "^1.3.1",
    "@sentry/nextjs": "catalog:",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "algoliasearch": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cross-env": "catalog:",
    "geist": "catalog:",
    "graphql": "catalog:",
    "lodash": "^4.18.1",
    "lodash.merge": "^4.6.2",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:storefront",
    "next-intl": "^4.14.9",
    "next-sitemap": "^4.2.3",
    "payload": "catalog:payload",
    "payload-components": "^1.7.0",
    "pg": "^8.23.1",
    "prism-react-renderer": "catalog:",
    "qs": "catalog:",
    "react": "catalog:",
    "react-country-flag": "^3.1.0",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-instantsearch": "^7.52.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "sass": "^1.106.1",
    "schema-dts": "^2.1.0",
    "server-only": "^0.0.1",
    "sharp": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss-radix": "^4.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medusajs/types": "catalog:medusa",
    "@medusajs/ui-preset": "catalog:medusa",
    "@tailwindcss/postcss": "catalog:",
    "@types/lodash": "^4.17.27",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-instantsearch-dom": "^6.12.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.6.1",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:storefront"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
